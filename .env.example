# Copy to .env in the repo root and fill in only the providers you will use.
# engine.py reads $PIPA_ENV first, then <repo>/.env. Never commit the real file.

# DashScope (qwen-plus, qwen-max, and the deepseek-* aliases)
DASHSCOPE_API_KEY=

# DeepSeek direct (deepseek-chat)
DEEPSEEK_API_KEY=

# OpenAI (gpt-4o-mini)
OPENAI_API_KEY=
